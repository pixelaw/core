#!/command/with-contenv /bin/bash
exec 2>&1
source /root/.bashrc

if [ "$DISABLE_KATANA" != "1" ]; then
    echo "Waiting for Katana on port 5050..."
    while ! nc -z localhost 5050 2>/dev/null; do
        sleep 1
    done
    echo "Katana is ready"
fi

exec torii \
    --rpc "$RPC_URL" \
    --world "$DOJO_WORLD_ADDRESS" \
    --http.cors_origins "*" \
    --db-dir "$TORII_DB" \
    --http.addr 0.0.0.0 \
    --indexing.pending
